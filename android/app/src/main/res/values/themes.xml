<resources>
    <!--
    Compose draws everything itself, so this only needs to give the Activity a window with no
    system action bar. Deliberately not a Theme.Material3.* style: those come from the Material
    Components XML library, which a Compose-only app has no other reason to depend on.
    -->
    <style name="Theme.ShadPS4" parent="android:Theme.DeviceDefault.NoActionBar" />
</resources>
